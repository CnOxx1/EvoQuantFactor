# 复制为 .env 后修改。勿将含真实密钥的 .env 提交到 Git。

# ---------- 服务 ----------
APP_HOST=0.0.0.0
APP_PORT=8080
# development | production（production 启动时会强制校验鉴权）
APP_ENV=production
TZ=Asia/Shanghai
# 生产请改为具体前端源，勿用 *
CORS_ORIGINS=http://127.0.0.1:5174

# ---------- 鉴权（生产务必关闭 AUTH_DISABLED，并设置非占位 Token）----------
AUTH_DISABLED=false
API_TOKEN=replace-with-a-long-random-token
# 本地若必须跳过生产校验：STRICT_PRODUCTION=false
STRICT_PRODUCTION=true

# ---------- 存储 ----------
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/factor
DATABASE_URL=sqlite:///./data/factor.db

# ---------- 任务 Worker / 超时 / 并发 ----------
WORKER_ENABLED=true
WORKER_CONCURRENCY=3
JOB_TIMEOUT_SEC=1800

# ---------- LLM 初始默认（运行时以 DB / 前端配置为准）----------
LLM_MOCK=true
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_STEP1=gpt-4o
LLM_MODEL_REVIEW=gpt-4o-mini

# ---------- 评审门槛 ----------
SAVE_MEAN_MIN=80
SAVE_MEDIAN_MIN=75
MAX_ROUND=3

# ---------- MCP（stub；true 时写入 stub 证据）----------
MCP_ENABLED=false
MCP_MARKET_URL=http://market-mcp:8100/sse

# ---------- 资讯/研报自动采集（入库 + 资讯摘要；因子需人工点分析）----------
REPORT_COLLECTOR_ENABLED=true
REPORT_COLLECTOR_INTERVAL_SEC=600
REPORT_COLLECTOR_SOURCES=eastmoney_report,eastmoney_news,wallstreetcn,sina,ths,jin10,luobo
REPORT_COLLECTOR_QTYPES=0,1,2,3
REPORT_COLLECTOR_NEWS_COLUMNS=350,344,355,354,351,353
REPORT_COLLECTOR_PAGE_SIZE=20
REPORT_COLLECTOR_LOOKBACK_HOURS=24
REPORT_COLLECTOR_REQUEST_GAP_SEC=1.5
REPORT_COLLECTOR_FINGERPRINT_DEDUPE=true
REPORT_COLLECTOR_PDF_REFETCH_LIMIT=5
REPORT_COLLECTOR_TITLE_BACKFILL_ON_START=true

# 萝卜投研（需登录）：浏览器打开 https://robo.datayes.com 登录后
# DevTools → Application → Cookies → 复制 cloud-sso-token 值
LUOBO_CLOUD_SSO_TOKEN=
# 或整段 Cookie：
# LUOBO_COOKIE=
LUOBO_COLLECT_FEEDS=true
LUOBO_COLLECT_REPORTS=true

NEWS_SUMMARIZE_ENABLED=true
# 并行摘要路数（每路一次 LLM/Cursor agent）；安全上限 NEWS_SUMMARIZE_WORKERS_CAP
NEWS_SUMMARIZE_WORKERS=8
NEWS_SUMMARIZE_WORKERS_CAP=32
NEWS_SUMMARIZE_QUEUE_MAX=500
NEWS_SUMMARIZE_MAX_RETRIES=2

# 本地一般不用设：默认指向仓库 prompts/ 与 config/
# Docker Compose 已在 environment 中注入 /app/prompts 与 /app/config
# PROMPTS_DIR=/workspace/prompts
# CONFIG_PATH=/workspace/config/default.yaml
