# 复制为 .env 后修改。勿将含真实密钥的 .env 提交到 Git。

# ---------- 服务 ----------
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=production
TZ=Asia/Shanghai
CORS_ORIGINS=*

# ---------- 鉴权（生产务必关闭 AUTH_DISABLED）----------
AUTH_DISABLED=false
API_TOKEN=please-change-me

# ---------- 存储 ----------
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/factor
DATABASE_URL=sqlite:///./data/factor.db

# ---------- 任务 Worker / 超时 / 并发 ----------
WORKER_ENABLED=true
WORKER_CONCURRENCY=3
JOB_TIMEOUT_SEC=1800

# ---------- LLM 初始默认（运行时以 DB / 前端配置为准）----------
LLM_MOCK=true
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_STEP1=gpt-4o
LLM_MODEL_REVIEW=gpt-4o-mini

# ---------- 评审门槛 ----------
SAVE_MEAN_MIN=80
SAVE_MEDIAN_MIN=75
MAX_ROUND=3

# ---------- MCP（stub；true 时写入 stub 证据）----------
MCP_ENABLED=false
MCP_MARKET_URL=http://market-mcp:8100/sse

PROMPTS_DIR=/app/prompts
CONFIG_PATH=/app/config/default.yaml
